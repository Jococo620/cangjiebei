# 鉴真智能体 (CangSight) 环境配置

# 服务器配置
NEXUS_PORT=7800
NEXUS_WORKSPACE=.
NEXUS_PROJECT_HASH=default

# LLM 配置（默认 DeepSeek，支持 deepseek / openai / tongyi / qwen）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# DeepSeek 配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI 配置（备用）
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com

# 通义千问配置（备用）
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# Qwen 配置（备用）
QWEN_API_KEY=your-qwen-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com

# Sympas MCP 配置
SYMPAS_MCP_URL=http://localhost:2266
SYMPAS_MCP_TOKEN=your-sympas-token-here

# 向量数据库配置
CHROMA_PERSIST_DIR=.nexus/chroma

# 合规模式（严格模式下禁用境外 Provider）
NEXUS_COMPLIANCE_MODE=false
